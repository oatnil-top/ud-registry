{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/oatnil-top/ud-registry/main/schema/plugins.schema.json",
  "title": "UnDercontrol plugin registry manifest",
  "description": "Shape of plugins.json. Clients fetch this file, browse plugins[], and install by downloading `file`, verifying its sha256 against the entry, then storing it as the user's own resource. See the design card f19addb5.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "plugins", "removed"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "plugins": {
      "type": "array",
      "items": { "$ref": "#/$defs/plugin" }
    },
    "removed": {
      "type": "array",
      "items": { "$ref": "#/$defs/removed" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "description", "version", "minProtocol",
        "extensions", "file", "sha256", "size", "author", "homepage"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "description": {
          "type": "object",
          "additionalProperties": false,
          "required": ["en", "zh"],
          "properties": {
            "en": { "type": "string", "minLength": 1 },
            "zh": { "type": "string", "minLength": 1 }
          }
        },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "minProtocol": { "type": "integer", "minimum": 1 },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^\\.[a-z0-9]+$" }
        },
        "file": {
          "type": "string",
          "pattern": "^plugins/[a-z0-9]([a-z0-9-]*[a-z0-9])?/[a-z0-9]([a-z0-9-]*[a-z0-9])?\\.html$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 0 },
        "author": { "type": "string", "minLength": 1 },
        "homepage": { "type": "string", "format": "uri" }
      }
    },
    "removed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason", "date"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date" }
      }
    }
  }
}
